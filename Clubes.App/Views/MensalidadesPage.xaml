<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Clubes.App.Views.MensalidadesPage" Title="Mensalidades">
<VerticalStackLayout Padding="16" Spacing="8">
  <Label Text="{Binding Resumo}" FontAttributes="Bold" />
  <CollectionView ItemsSource="{Binding Itens}">
    <CollectionView.ItemTemplate><DataTemplate>
      <Grid ColumnDefinitions="*,Auto,Auto" Padding="4" ColumnSpacing="8">
        <Label Text="{Binding Competencia, StringFormat='{0:MM/yyyy}'}" />
        <Label Grid.Column="1" Text="{Binding Valor, StringFormat='{0:C}'}" />
        <Label Grid.Column="2" Text="{Binding Situacao}" />
      </Grid>
    </DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
</VerticalStackLayout>
</ContentPage>
